# ============ 依赖 ============
node_modules/

# ============ 构建产物 ============
dist/
dist-ssr/
.vite/

# ============ SQLite 运行时文件与自动备份 ============
# 主库 server/data/crm.db 需要纳入版本管理（详见 README）
server/data/*.db-wal
server/data/*.db-shm
server/data/backups/

# ============ 日志与临时文件 ============
*.log
npm-debug.log*
yarn-error.log*
*.tmp
*.temp

# ============ 本地环境变量覆盖 ============
# 说明：web/.env.development、web/.env.production 属于共享配置，正常提交
.env.local
.env.*.local
*.local

# ============ 操作系统 / 编辑器 ============
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
